# Fill the key for the provider selected in your agent template.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional: the example template currently selects DeepSeek via this variable.
TW_SOLO_LLM_KEY=

# Owner setup details for the browser spike; these do not configure the binary.
