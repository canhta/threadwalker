# Example key named by a template's llm.api_key_env.
LLM_API_KEY=

# Example key for a second provider; optional unless a template or eval profile uses it.
SECONDARY_LLM_API_KEY=

# Memory embeddings (OpenAI text-embedding-3-large); required.
OPENAI_API_KEY=

# Owner notifications and commands.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=

# Threads API (backend: api). The long-lived token is refreshed in the database;
# THREADZ_SECRET_KEY is base64 of 32 random bytes (openssl rand -base64 32).
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=
THREADZ_SECRET_KEY=

# run -api-listen: the public https origin the Meta app points at (OAuth callback,
# webhooks, privacy and data-deletion pages). -api-url overrides it.
THREADZ_API_URL=
